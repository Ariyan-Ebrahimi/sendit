# Copy to .env (deploy/setup-vps.sh creates it for you with random secrets).
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://sendit_user:CHANGE_THIS_PASSWORD@localhost:5432/sendit_db
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=
MAX_FILE_SIZE_MB=1024
TRANSFER_TTL_HOURS=24
# Storage each user may use for live shares (MB). The admin page can change it per user.
USER_QUOTA_MB=2048
# Admin page at /admin (user "admin"). setup-vps.sh generates this for you.
ADMIN_PASSWORD=
# Optional: send password-reset codes by email. Without these, codes show on the admin page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
