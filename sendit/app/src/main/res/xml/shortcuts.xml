<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="send"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_send"
        android:shortcutShortLabel="@string/shortcut_send">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.beamdrop.app"
            android:targetClass="com.beamdrop.app.MainActivity">
            <extra android:name="open_screen" android:value="send" />
        </intent>
    </shortcut>
